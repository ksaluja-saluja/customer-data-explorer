{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "strict": true,
    "esModuleInterop": true,
    "moduleResolution": "node",
    "types": ["node"],
    "resolveJsonModule": true,
    "outDir": "./dist"
  },
  "include": ["src/**/*", "lib/**/*", "bin/**/*"],
  "exclude": ["node_modules", "dist"]
}